    <node id="entity-df1b307fd635b1fb492cb1fdf9de">
      <data key="d0">Fusarium head blight</data>
      <data key="d1">PlantDisease</data>
    </node>
    <edge source="entity-9dec999a13aeff7be6126d3c4dd9" target="entity-df1b307fd635b1fb492cb1fdf9de" id="candidate-c3dabf70484b7c7005205a84ed629be8">
