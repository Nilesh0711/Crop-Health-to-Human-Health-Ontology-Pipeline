    <!-- http://purl.obolibrary.org/obo/PCO_0000029 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000029">
        <rdfs:label xml:lang="en">multi-species collection of organisms</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
        <rdfs:subClassOf>
