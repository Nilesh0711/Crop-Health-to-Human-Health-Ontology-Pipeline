    <!-- http://purl.obolibrary.org/obo/PATO_0000915 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000915">
        <rdfs:label>thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001708"/>
        <ns3:IAO_0000115>A 1-D extent quality which is equal to the dimension through an object as opposed to its length or width.</ns3:IAO_0000115>
        <ns4:seeAlso>https://github.com/pato-ontology/pato/issues/337</ns4:seeAlso>
        <oboInOwl:id>PATO:0000915</oboInOwl:id>
        <rdfs:comment>Thickness often refers to the smallest 1-D extent compared to the other two orthogonal dimensions, however, this is not always true. See https://github.com/pato-ontology/pato/issues/337 for full discussion.</rdfs:comment>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#attribute_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#scalar_slim"/>
    </Class>
    


