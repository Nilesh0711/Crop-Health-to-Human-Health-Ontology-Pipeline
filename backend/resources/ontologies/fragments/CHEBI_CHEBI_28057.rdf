    <!-- http://purl.obolibrary.org/obo/CHEBI_28057 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28057">
        <rdfs:label>amylopectin</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_65212"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
