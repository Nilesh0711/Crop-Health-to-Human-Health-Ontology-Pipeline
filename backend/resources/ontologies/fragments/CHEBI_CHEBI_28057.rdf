            </Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasAlternativeId>CHEBI:2693</oboInOwl:hasAlternativeId>
        <oboInOwl:hasRelatedSynonym>Amioca</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:28057</oboInOwl:id>
        <oboInOwl:hasDbXref>cas:9037-22-3</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Amylopectin, unspecified source</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amylopectin, corn</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasDbXref>kegg.compound:C00317</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasAlternativeId>CHEBI:22538</oboInOwl:hasAlternativeId>
        <oboInOwl:hasRelatedSynonym>Amylopectin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amylopectin from maize</oboInOwl:hasRelatedSynonym>
        <ns4:IAO_0000115>A polydisperse highly branched polysaccharide derivative composed of chains of &lt;small&gt;D&lt;/small&gt;-glucopyranose residues in α(1→4) glycosidic linkage. The chains are joined together by α(1→6) glycosidic linkages. A small number of α(1→3) glycosidic linkages and some 6-phosphate ester groups also may occur. The branches in amylopectin typically contain 24 to 30 glucose residues.</ns4:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
    </Class>
    


