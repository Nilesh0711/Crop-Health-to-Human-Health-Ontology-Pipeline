      <data key="d6">0</data>
      <data key="d7">Fusarium head blight reduces wheat yields and therefore directly reduces food production.</data>
      <data key="d8">causal</data>
      <data key="d9">{"crop_or_species": "wheat", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Crop health and its global impacts on the components of food security</data>
      <data key="d12">The disease reduces yields and therefore directly reduces food production (Component 1).</data>
      <data key="d13">["neighbor-3e1ebfea71e003a1b4ac94b5ff4f"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
