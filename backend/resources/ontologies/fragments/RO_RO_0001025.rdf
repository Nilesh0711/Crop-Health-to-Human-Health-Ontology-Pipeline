    <!-- http://purl.obolibrary.org/obo/BFO_0000050 -->

    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">part of</rdfs:label>
    </ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001025 -->

    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001025">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">located in</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Located_in</rdfs:seeAlso>
        <ns3:IAO_0000116 xml:lang="en">Location as a relation between instances: The primitive instance-level relation c located_in r at t reflects the fact that each continuant is at any given time associated with exactly one spatial region, namely its exact location. Following we can use this relation to define a further instance-level location relation - not between a continuant and the region which it exactly occupies, but rather between one continuant and another. c is located in c1, in this sense, whenever the spatial region occupied by c is part_of the spatial region occupied by c1.    Note that this relation comprehends both the relation of exact location between one continuant and another which obtains when r and r1 are identical (for example, when a portion of fluid exactly fills a cavity), as well as those sorts of inexact location relations which obtain, for example, between brain and head or between ovum and uterus</ns3:IAO_0000116>
        <dcterms:source>http://www.obofoundry.org/ro/#OBO_REL:located_in</dcterms:source>
        <ns3:IAO_0000116 xml:lang="en">Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/</ns3:IAO_0000116>
        <ns3:IAO_0000115 xml:lang="en">a relation between two independent continuants, the target and the location, in which the target is entirely within the location</ns3:IAO_0000115>
        <ns3:IAO_0000111 xml:lang="en">located in</ns3:IAO_0000111>
        <ns3:IAO_0000118 xml:lang="en">located_in</ns3:IAO_0000118>
        <ns3:IAO_0000112 xml:lang="en">my brain is located in my head</ns3:IAO_0000112>
        <ns3:IAO_0000112 xml:lang="en">this rat is located in this cage</ns3:IAO_0000112>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <ns3:RO_0001900 rdf:resource="http://purl.obolibrary.org/obo/RO_0001901"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_gp2term"/>
        <propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0001025"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050"/>
        </propertyChainAxiom>
        <rdfs:range>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    <Class>
                        <complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
                    </Class>
                </intersectionOf>
            </Class>
        </rdfs:range>
        <rdfs:domain>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    <Class>
                        <complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
                    </Class>
                </intersectionOf>
            </Class>
        </rdfs:domain>
    </ObjectProperty>
    


