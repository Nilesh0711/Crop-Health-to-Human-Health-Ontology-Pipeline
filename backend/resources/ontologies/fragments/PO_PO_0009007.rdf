    <!-- http://purl.obolibrary.org/obo/PO_0009007 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PO_0009007">
        <rdfs:label>portion of plant tissue</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
        <disjointWith rdf:resource="http://purl.obolibrary.org/obo/PO_0009008"/>
