    <!-- http://purl.obolibrary.org/obo/PO_0020121 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PO_0020121">
        <rdfs:label>lateral root</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000016"/>
            </Restriction>
        </rdfs:subClassOf>
        <ns4:IAO_0000115>A root (PO:0009005) that develops from a lateral root primordium (PO:0000016) that is part of another root on the same plant.</ns4:IAO_0000115>
        <oboInOwl:hasExactSynonym>ra&amp;#237z lateral (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:id>PO:0020121</oboInOwl:id>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <rdfs:comment>A lateral root primordium may develops on any root, including a primary root (PO:0020127), on an existing lateral root (PO:0020121), or a shoot-borne root (PO:0000042). In seed plants, a lateral root primordium generally develops from pericycle cells (PO:0025261), but cells of an endodermis (PO:0000252) may also participate in its formation in some species. In ferns, lateral root primordia develop from the endodermis.</rdfs:comment>
        <oboInOwl:hasExactSynonym>側根 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasDbXref>PO_GIT:473</oboInOwl:hasDbXref>
