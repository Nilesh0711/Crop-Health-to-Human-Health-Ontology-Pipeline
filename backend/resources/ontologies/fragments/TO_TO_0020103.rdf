    <!-- http://purl.obolibrary.org/obo/TO_0020103 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/TO_0020103">
        <rdfs:label>adventitious root length</rdfs:label>
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PATO_0000122"/>
                    <Restriction>
