    <!-- http://purl.obolibrary.org/obo/PO_0000256 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PO_0000256">
        <rdfs:label>root hair cell</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025164"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000262"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Compare with non-hair root epidermal cell (PO:0000263). This term is for an entire epidermal cell that contains a root hair extension. To describe only the cell extension, see root hair (GO:0035618) or root hair tip (GO:0035619).</rdfs:comment>
        <oboInOwl:hasExactSynonym>c&amp;#233lula del pelo de la ra&amp;#237z (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>根毛細胞 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:id>PO:0000256</oboInOwl:id>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <ns4:IAO_0000115>A root epidermal cell (PO:0025164) that develops from a trichoblast (PO:0000262) and has as part a root hair (GO:0035618).</ns4:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#CL"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
    </Class>
    


