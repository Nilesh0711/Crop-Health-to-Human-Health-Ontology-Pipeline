    <!-- http://purl.obolibrary.org/obo/PO_0004543 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PO_0004543">
        <rdfs:label>shoot axis tuber</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025522"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0025073"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Functions in storage of photosynthate metabolites. This term should be used for tubers derived from branches, as found in Solanum spp. (e.g. potato) or Dioscorea spp. (e.g. yam) and other species. Use the term tuberous root tuber (PO:0025476) for tubers derived from roots, such as those found in Cassava, Ipomoea, or Hemerocallis.</rdfs:comment>
        <oboInOwl:hasExactSynonym>tub&amp;#233rculo (Spanish, exact)</oboInOwl:hasExactSynonym>
        <ns4:IAO_0000115>A shoot axis (PO:0025029) that develops from a branch (PO:0025073) and is radially enlarged for storage.</ns4:IAO_0000115>
        <oboInOwl:hasExactSynonym>tuber branch (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasBroadSynonym>diaspore (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0004543</oboInOwl:id>
        <oboInOwl:hasExactSynonym>シュート軸塊茎 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shoot axis branch tuber (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasDbXref>PO_GIT:127</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Potato"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
