# Secrets and local machine config
.env
.env.*
!.env.example

deliverables/*
ppt/*
# Documentation and presentations remain local
docs/

# Python caches and temporary test directories
.pytest_cache/
.pytest_tmp*/
.pytest_temp/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
tmp_pytest/
__pycache__/
*.py[cod]
pdf/*
!pdf/.gitkeep
!pdf/README.md

# Local virtual environments
.venv/
.venv*/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Fresh pipeline outputs (source PDFs stay versioned)
ontology/*
!ontology/.gitkeep
!ontology/README.md

# Generated developer reports (keep the directory guide)
reports/*
!reports/README.md

# Local comparison snapshots include PDFs, results and model-response archives.
archive/backup/
archive/paused_validation/
archive/pdfs/

# Local experiments, model responses and run audits (preserved on disk)
analysis/*
!analysis/grounding_pilot/
analysis/grounding_pilot/*
!analysis/grounding_pilot/README.md

# Thesis sources and build artifacts kept local
MTP_Thesis/

# Export staging and local Render snapshots stay untracked; deploy/pages/data/ holds the lightweight static site source.
deploy/render/snapshot/
deploy/render/.snapshot-*/
deploy/pages/.snapshot-*/
deploy/pages/.static-building-*/
