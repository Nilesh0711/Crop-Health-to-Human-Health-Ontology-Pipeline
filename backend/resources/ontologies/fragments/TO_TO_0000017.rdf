    <!-- http://purl.obolibrary.org/obo/TO_0000017 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/TO_0000017">
        <rdfs:label>plant morphology trait</rdfs:label>
        <equivalentClass>
