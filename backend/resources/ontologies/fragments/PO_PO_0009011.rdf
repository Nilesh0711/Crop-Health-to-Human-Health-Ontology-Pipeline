    <Class rdf:about="http://purl.obolibrary.org/obo/PO_0009011">
        <rdfs:label>plant structure</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025131"/>
        <rdfs:comment>&#39;Part&#39; includes both proper parts and the whole plant. CARO:0000003 &#39;connected anatomical structure&#39; is defined as: Material anatomical entity that is a single connected structure with inherent 3D shape, generated by coordinated expression of the organism&#39;s own genome.</rdfs:comment>
