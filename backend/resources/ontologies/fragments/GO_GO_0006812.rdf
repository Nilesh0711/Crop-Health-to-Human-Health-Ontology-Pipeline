        <oboInOwl:hasNarrowSynonym>di-, tri-valent inorganic cation transport</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasAlternativeId>GO:0015674</oboInOwl:hasAlternativeId>
    </Class>
