    <!-- http://purl.obolibrary.org/obo/PATO_0001470 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001470">
        <rdfs:label>ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <oboInOwl:hasExactSynonym>quotient</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proportionality</oboInOwl:hasExactSynonym>
        <ns3:IAO_0000115>A quality inhering in a bearer by virtue of the bearer&#39;s magnitude in proportion to the magnitude of another entity.</ns3:IAO_0000115>
        <oboInOwl:id>PATO:0001470</oboInOwl:id>
        <oboInOwl:hasRelatedSynonym>rate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym>proportionality to</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proportion</oboInOwl:hasExactSynonym>
        <rdfs:comment>Examples: height to weight; brain size to body size; root to shoot ratio; urinary sodium to potassium ratio. waist-hip ratio.</rdfs:comment>
