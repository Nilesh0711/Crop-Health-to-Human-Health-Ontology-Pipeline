    <!-- http://purl.obolibrary.org/obo/GO_0048364 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/GO_0048364">
        <rdfs:label>root development</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0099402"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0022622"/>
            </Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0048364</oboInOwl:id>
        <ns4:IAO_0000115>The process whose specific outcome is the progression of the root over time, from its formation to the mature structure. The root is the water- and mineral-absorbing part of a plant which is usually underground, does not bear leaves, tends to grow downwards and is typically derived from the radicle of the embryo.</ns4:IAO_0000115>
    </Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0099402 -->

