    <!-- http://purl.obolibrary.org/obo/CHEBI_62764 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_62764">
        <rdfs:label>reactive nitrogen species</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51143"/>
        <ns3:IAO_0000115>A family of nitrogen molecular entities which are highly reactive and derived from nitric oxide (•NO) and superoxide (O&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt;•&lt;small&gt;&lt;sup&gt;−&lt;/small&gt;&lt;/sup&gt;) produced via the enzymatic activity of inducible nitric oxide synthase 2 (NOS2) and NADPH oxidase respectively.</ns3:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:12076975</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>RNS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasDbXref>pubmed:9741578</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Reactive_nitrogen_species</oboInOwl:hasDbXref>
        <oboInOwl:id>CHEBI:62764</oboInOwl:id>
        <oboInOwl:hasRelatedSynonym>RNI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasDbXref>pubmed:17667957</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
