    <!-- http://purl.obolibrary.org/obo/GO_0005315 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/GO_0005315">
        <rdfs:label>phosphate transmembrane transporter activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015291"/>
        <ns3:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/27121</ns3:IAO_0000233>
        <ns3:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/27521</ns3:IAO_0000233>
        <oboInOwl:hasDbXref>Reactome:R-HSA-5226964</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inorganic phosphate transmembrane transporter activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0005315</oboInOwl:id>
        <oboInOwl:hasAlternativeId>GO:1901677</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0005317</oboInOwl:hasAlternativeId>
        <ns3:IAO_0000115>Enables the transfer of phosphate ions from one side of a membrane to the other, up its concentration gradient. The transporter binds the solute and undergoes a series of conformational changes. Transport works equally well in either direction and is driven by a chemiosmotic source of energy. Secondary active transporters include symporters and antiporters.</ns3:IAO_0000115>
    </Class>
    


