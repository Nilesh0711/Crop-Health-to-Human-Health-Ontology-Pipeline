    <!-- http://purl.obolibrary.org/obo/GO_0071941 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/GO_0071941">
        <rdfs:label>nitrogen cycle metabolic process</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008152"/>
        <oboInOwl:id>GO:0071941</oboInOwl:id>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-09-30T05:21:03Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasDbXref>Wikipedia:Nitrogen_cycle</oboInOwl:hasDbXref>
        <ns3:IAO_0000115>A nitrogen compound metabolic process that contributes to the nitrogen cycle. The nitrogen cycle is a series of metabolic pathways by which nitrogen is converted between various forms and redox states; it encompasses pathways in which nitrogen is acted upon directly, such as nitrification, denitrification, nitrogen fixation, and mineralization.</ns3:IAO_0000115>
