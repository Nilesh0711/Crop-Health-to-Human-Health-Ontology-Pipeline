    <edge source="entity-aeec5c69f5f5c17fcdef67569c1c" target="entity-134991ef70c5cbd0c69f002556d0" id="candidate-920beee290d31517199fe3503dbc894b">
      <data key="d2">candidate-920beee290d31517199fe3503dbc894b</data>
      <data key="d3">restricts</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Waterlogging and hypoxia in compacted soils severely restrict root growth and function.</data>
      <data key="d8">causal</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Conversely, soils characterized by high compaction and poor permeability can result in waterlogging and hypoxia, which severely restrict root growth and function, ultimately impairing plant health and productivity (Manik et al., 2019).</data>
      <data key="d13">["neighbor-7c5cc886733b793bf5872c5cbb83"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-92ed6c5a0a14ea3942e09ebfccdf" target="entity-d45b5e3f5019b2d3d46b9337e8a4" id="candidate-13ecb03e2cc098db9961af7dd9bf25b3">
      <data key="d2">candidate-13ecb03e2cc098db9961af7dd9bf25b3</data>
      <data key="d3">vulnerable_to</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Sandy soils are particularly vulnerable to drought due to their poor water retention.</data>
      <data key="d8">descriptive</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Sandy soils are particularly vulnerable to drought due to their poor water retention, while acidic soils can limit the growth of certain crops (Naorem et al., 2023).</data>
      <data key="d13">["neighbor-c6e0702570e30178c3a090430e64"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-805419aa2d5091746f9138a80a05" target="entity-0371c3e8980ff07403f1e8a875a9" id="candidate-f15931e0046acba17da885ed8b6a6699">
      <data key="d2">candidate-f15931e0046acba17da885ed8b6a6699</data>
      <data key="d3">mobilizes</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Soil acidification can mobilize toxic metals such as aluminum, which can inhibit root growth and function.</data>
      <data key="d8">descriptive</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Furthermore, this acidification can mobilize toxic metals such as aluminum, which can inhibit root growth and function (Baloch et al., 2024).</data>
      <data key="d13">["neighbor-ca327ef6ba05c1be4f2dcbd1eb57"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-d45b5e3f5019b2d3d46b9337e8a4" target="entity-98d68ba2a60813a3f37ac0e0dffa" id="candidate-01367c80c77dad54f73a93f9f83960a0">
      <data key="d2">candidate-01367c80c77dad54f73a93f9f83960a0</data>
      <data key="d3">causes</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Under drought stress, crops reduce stomatal opening to decrease water transpiration.</data>
      <data key="d8">causal</data>
      <data key="d9">{"crop_or_species": "crops", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Under drought stress, crops reduce stomatal opening to decrease water transpiration and increase root surface area, thereby enhancing their water absorption capacity (Seleiman et al., 2021).</data>
      <data key="d13">["neighbor-c6e0702570e30178c3a090430e64"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-618ac625c872c928b431553d46a9" target="entity-86ea45a35ff75df773e69dcc4cba" id="candidate-5e91ae36a686fc9bdb2459cd007a718e">
      <data key="d2">candidate-5e91ae36a686fc9bdb2459cd007a718e</data>
      <data key="d3">contributes_to</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Microbial activity contributes to soil aggregate formation and stabilization by producing extracellular polymeric substances and binding soil particles.</data>
      <data key="d8">descriptive</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">On a microstructural level, microbial activity contributes to the formation and stabilization of soil aggregates by producing extracellular polymeric substances and facilitating the binding of soil particles.</data>
      <data key="d13">["neighbor-2e7e81b86313ecdc47c31a51b9a8"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-230991541f1c8111b7e572af4a4f" target="entity-3415427df404937e606a0ad77914" id="candidate-9597933612b7ceb78248044ddaf023bd">
      <data key="d2">candidate-9597933612b7ceb78248044ddaf023bd</data>
      <data key="d3">attracts</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Root exudates secreted by crop root systems can attract soil microorganisms.</data>
      <data key="d8">descriptive</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Concurrently, root exudates secreted by crop root systems can attract soil microorganisms, fostering a symbiotic relationship that enhances microbial diversity and abundance.</data>
      <data key="d13">["neighbor-617282b509440aa70484c9782329"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-230991541f1c8111b7e572af4a4f" target="entity-3415427df404937e606a0ad77914" id="candidate-f5f261a84116918cebd92a5fba0e1983">
      <data key="d2">candidate-f5f261a84116918cebd92a5fba0e1983</data>
      <data key="d3">provides_nutrients_for</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">Organic substances released by crop roots provide energy and nutrients for soil microbes.</data>
      <data key="d8">causal</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Organic substances released by crop roots provide energy and nutrients for soil microbes, promoting their growth and metabolic activity.</data>
      <data key="d13">["neighbor-2e22dbf09668af069cefa5614933", "neighbor-78d0dd640de7d4bb9c29fca1d4f2", "neighbor-fc4cc7ff9c8d9487d7e049073343", "neighbor-0406b58788d33e18c4868bfcc7b7", "neighbor-ecb4766ab62cfe3aa03519c91846", "neighbor-e25dac0f7f8a47ac664a5747eb50"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-23a777a7faf1954db445cadf0d00" target="entity-3415427df404937e606a0ad77914" id="candidate-f46731005e38087ca322d78a48a9e532">
      <data key="d2">candidate-f46731005e38087ca322d78a48a9e532</data>
      <data key="d3">enhances</data>
      <data key="d4">local_connection_supported</data>
      <data key="d5">0</data>
      <data key="d6">0</data>
      <data key="d7">The implementation of crop rotation can enhance soil microbial diversity.</data>
      <data key="d8">descriptive</data>
      <data key="d9">{"crop_or_species": "", "population": "", "condition": "", "comparator": "", "metric": ""}</data>
      <data key="d10">False</data>
      <data key="d11">Exploring the link between soil health and crop productivity</data>
      <data key="d12">Furthermore, the implementation of cover crops and crop rotation can enhance soil microbial diversity while maintaining the balance of soil nutrients.</data>
      <data key="d13">["neighbor-f1621cfbc65442d855e837e9acb9", "neighbor-a5fd95f3a7ccfaeb75a174abe93f", "neighbor-675c55ed7c063ecd3cf3323de5e1", "neighbor-6487956fa7a262a29bf39bdf55d2"]</data>
      <data key="d14">False</data>
      <data key="d15">True</data>
    </edge>
    <edge source="entity-0371c3e8980ff07403f1e8a875a9" target="entity-134991ef70c5cbd0c69f002556d0" id="candidate-fb57a084ba3b934002bce30cec35f424">
      <data key="d2">candidate-fb57a084ba3b934002bce30cec35f424</data>
