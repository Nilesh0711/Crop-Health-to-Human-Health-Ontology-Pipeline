    <!-- http://purl.obolibrary.org/obo/GO_0015399 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/GO_0015399">
        <rdfs:label>primary active transmembrane transporter activity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0022804"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
