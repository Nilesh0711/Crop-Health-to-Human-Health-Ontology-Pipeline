# Secrets and local machine config
.env
.env.*
!.env.example

deliverables/*
ppt/*
# Documentation and presentations remain local
docs/

# Python caches and temporary test directories
.pytest_cache/
.pytest_tmp/
tmp_pytest/
__pycache__/
*.py[cod]
pdf/*
!pdf/.gitkeep
!pdf/README.md

# Local virtual environments
.venv/
.venv*/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Fresh pipeline outputs (source PDFs stay versioned)
ontology/*
!ontology/.gitkeep
!ontology/README.md

# Generated developer reports (keep the directory guide)
reports/*
!reports/README.md

# Local comparison snapshots include PDFs, results and model-response archives.
archive/backup/

# Thesis sources and build artifacts kept local
MTP_Thesis/

# Export staging and previous publications stay local. The checked snapshot is deployable source.
deploy/render/.snapshot-*/
