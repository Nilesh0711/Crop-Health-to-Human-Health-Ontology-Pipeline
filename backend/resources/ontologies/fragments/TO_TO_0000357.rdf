    <!-- http://purl.obolibrary.org/obo/TO_0000357 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/TO_0000357">
        <rdfs:label>plant growth and development trait</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TO_0000387"/>
        <oboInOwl:created_by>jaiswalp</oboInOwl:created_by>
