    <!-- http://purl.obolibrary.org/obo/PO_0009015 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/PO_0009015">
        <rdfs:label>portion of vascular tissue</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
        <oboInOwl:hasDbXref>BTO:0001432</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>維管束細胞の一部 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <ns3:IAO_0000115>A portion of plant tissue (PO:0009007) that has as part one or more tracheary elements (PO:0000290) or sieve elements (PO:0025406).</ns3:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>vascular system (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym>vascular tissue (exact)</oboInOwl:hasExactSynonym>
