    <!-- http://purl.obolibrary.org/obo/RO_0002131 -->

    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002131">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">overlaps</rdfs:label>
        <ns2:IAO_0000424>http://purl.obolibrary.org/obo/BFO_0000051 some (http://purl.obolibrary.org/obo/BFO_0000050 some ?Y)</ns2:IAO_0000424>
