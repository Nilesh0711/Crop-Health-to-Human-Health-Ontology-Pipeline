    <!-- http://purl.obolibrary.org/obo/RO_0002410 -->

    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002410">
        <rdfs:label xml:lang="en">causally related to</rdfs:label>
    </ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002501 -->

    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002501">
        <rdfs:label>causal relation between processes</rdfs:label>
        <ns2:IAO_0000232>Do not use this relation directly. It is intended as a grouping for a diverse set of relations, all involving cause and effect.</ns2:IAO_0000232>
        <ns2:IAO_0000115>p is causally related to q if and only if p or any part of p and q or any part of q are linked by a chain of events where each event pair is one where the execution of p influences the execution of q. p may be upstream, downstream, part of, or a container of q.</ns2:IAO_0000115>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002410"/>
        <ns2:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/ro/docs/causal-relations"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    </ObjectProperty>
    


